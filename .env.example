# ─────────────────────────────────────────────────────
# RetailOS — Environment Variables Template
# Copy to .env and fill in all values before running
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────

# ── DATABASE ──────────────────────────────────────────
DB_NAME=retailos
DB_USER=retailos_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS

# ── REDIS ─────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── JWT SECRETS (generate with: openssl rand -hex 64) ─
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_64_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_64_CHARS_MIN
JWT_SUPER_ADMIN_SECRET=CHANGE_ME_SUPER_ADMIN_SECRET_DIFFERENT

# ── ENCRYPTION (AES-256: openssl rand -hex 32) ────────
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
PYTHON_SECRET_KEY=CHANGE_ME_PYTHON_SECRET

# ── RAZORPAY ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET

# ── WHATSAPP BUSINESS API ─────────────────────────────
WA_ACCESS_TOKEN=CHANGE_ME_META_ACCESS_TOKEN
WA_PHONE_NUMBER_ID=CHANGE_ME_PHONE_NUMBER_ID
WA_BUSINESS_ACCOUNT_ID=CHANGE_ME_BUSINESS_ACCOUNT_ID
WA_VERIFY_TOKEN=CHANGE_ME_WA_WEBHOOK_VERIFY_TOKEN

# ── AWS ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET
S3_BUCKET=retailos-assets-prod
S3_REGION=ap-south-1

# ── FIREBASE (FCM Push Notifications) ─────────────────
FCM_SERVER_KEY=CHANGE_ME_FCM_SERVER_KEY
FIREBASE_PROJECT_ID=CHANGE_ME_PROJECT_ID

# ── B2B PROCUREMENT APIS ──────────────────────────────
UDAAN_CLIENT_ID=CHANGE_ME_UDAAN_CLIENT_ID
UDAAN_CLIENT_SECRET=CHANGE_ME_UDAAN_SECRET
UDAAN_BASE_URL=https://api.udaan.com/v1
JIOMART_API_KEY=CHANGE_ME_JIOMART_KEY
JIOMART_BASE_URL=https://partner.jiomart.com/api/v1

# ── GST SUVIDHA PROVIDER (GSTIN Verification) ─────────
GSP_API_KEY=CHANGE_ME_GSP_KEY
GSP_BASE_URL=https://api.mastersindia.co/commonapi/v2

# ── NIC E-INVOICE (for stores > ₹5Cr turnover) ────────
NIC_E_INVOICE_URL=https://einvoice1.gst.gov.in/eicore/v1.03
NIC_USERNAME=CHANGE_ME
NIC_PASSWORD=CHANGE_ME

# ── SUPER ADMIN ───────────────────────────────────────
SUPER_ADMIN_TOTP_ISSUER=RetailOS-SuperAdmin
SUPER_ADMIN_ALLOWED_IPS=127.0.0.1,YOUR_OFFICE_IP

# ── APP CONFIG ────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_BASE_URL=https://api.retailos.app
FRONTEND_URL=https://app.retailos.app
CORS_ORIGINS=https://app.retailos.app,https://admin.retailos.app
LOG_LEVEL=info
